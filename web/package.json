{
  "name": "till-infinity-web",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only dashboard for the till_infinity trading desk.",
  "scripts": {
    "dev": "bash ./dev.sh",
    "dev:web": "TILL_WEB_BIND=127.0.0.1 next dev -H 127.0.0.1 --port 3000",
    "dev:api": "cd .. && uv run --extra dashboard uvicorn web.api.main:app --host 127.0.0.1 --port 8787",
    "build": "next build",
    "start": "TILL_WEB_BIND=127.0.0.1 next start -H 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lightweight-charts": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
