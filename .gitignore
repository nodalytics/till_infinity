# Claude Code
# Everything Claude Code keeps here is local - settings, worktrees - except
# the skills, which are written for whoever works on this next and belong in
# the repo. `.claude/*` rather than `.claude/`: git will not re-include a path
# whose parent directory is excluded, so the directory itself has to stay in.
.claude/*
!.claude/skills/
__pycache__/
.venv-research/

# Recorded option surfaces. Market data, never committed.
options-data/

# A PyObjC artifact - a dump of Apple Foundation/AppKit class metadata that lands
# in the working directory when PyObjC scans Objective-C frameworks. Nothing here
# uses it, nothing references it, and it got staged once by an accidental add -A.
NewClasses.plist

# A local `models retrain` writes its run log beside the model it promotes.
till_infinity/models/*.report.jsonl
till_infinity/models/retrain.last
.playwright-mcp/
