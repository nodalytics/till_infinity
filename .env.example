# Till Infinity - copy to `.env` and edit. Real environment variables win over
# this file, so a proper deployment is never overridden by a stray .env.

# ── which services `till-infinity run` starts ────────────────────────────────
PRICES_ENABLED=1
NEWS_ENABLED=1
STRUCTURES_ENABLED=1
NOTIFICATIONS_ENABLED=1
JOURNAL=1

# Agents are the only part needing a paid credential, so they are off by
# default - the collectors and the levels model should not be hostage to it.
AGENTS_ENABLED=0

# An actionable level call goes to the channel without an agent in between.
# With this off and agents disabled, level calls are published to a topic
# nobody is subscribed to and the channel carries only feed faults.
# STRUCTURES_ALERT_LEVELS=1

# ── the bus ─────────────────────────────────────────────────────────────────
# Unset means an in-process bus: fine for one `run`, useless across processes.
# TILL_REDIS_URL=redis://localhost:6379

# ── what to collect ─────────────────────────────────────────────────────────
# Unset collects everything: all fourteen instruments, and every interval from 1m
# to 1w. Set these only to narrow it - a shorter list is a smaller sweep, not a
# better one, and levels are built on 1m/3m/5m/15m/1h/4h/1d/1w.
# SYMBOLS=gold,btc,eth,sol,eurusd,gbpusd,usdjpy,audusd,usdcad,usdchf,nzdusd,usdcnh,us100,spx500
# INTERVALS=1m,3m,5m,15m,1h,2h,4h,1d,1w
# PRICES_CYCLE_S=60
# NEWS_POLL=300

# ── where it lands ──────────────────────────────────────────────────────────
# PRICES_DB=.data/prices/prices.db
# NEWS_DB=.data/news/news.db

# Which providers to poll. Empty takes the default set; `fred` is not in it
# because it refuses to start without a key rather than collecting nothing.
# NEWS_SOURCES=rss,forexfactory,tradingview,headlines,imf,fred
#
# Monetary policy from the St. Louis Fed: balance sheets, the curve, and the
# daily breakevens that price inflation between monthly CPI prints. Required
# for the `fred` source - the keyless endpoint answers 400.
# FRED_API_KEY=
# FRED_SERIES=DGS10,DGS2,T10YIE          # empty means all thirty
#
# Positioning from the CFTC's Commitments of Traders - who is actually holding
# the contracts, reported weekly rather than inferred from price. No key. It is
# the only *observed* supply-and-demand data reachable from this broker feed,
# which has a spread and no book behind it. Add `cot` to NEWS_SOURCES.
#
# Tuesday's positions, published Friday, so the freshest reading is three days
# old. See research/positioning.md for what that is likely to be worth.
#
# Instruments only the broker carries, read from the terminal over the MT5
# bridge. Synthetics have no underlying, so no venue quotes them and this is
# the only way to reach them - and they are the only thing here that trades at
# a weekend.
#
# This list and `SYNTHETICS` in trading/config.py have to agree. Trading
# registers what is in the code; prices collects what is named here. Set one
# without the other and you get an instrument that resolves and has no prices,
# or a feed that quotes and cannot be traded.
#
# Which ones is a measured question, not a taste: see research/catalogue.md.
# In volatility units - what `charge_spread` actually deducts - the synthetics
# cost 0.170v to cross against FX's 2.267v, which is the opposite of what the
# raw point spreads say. A scalp whose expected push is one or two units cannot
# pay two units to get in and out.
# PRICES_BROKER_SYMBOLS=Volatility 75 Index,Step Index,Boom 1000 Index
# JOURNAL_DB=.data/journal/journal.db
# STRUCTURES_DIR=.data/structures

# ── models (only read when AGENTS_ENABLED=1) ────────────────────────────────
# provider:model - a bare name is Anthropic's. See `till-infinity agents providers`.
# AGENTS_MODEL=claude-opus-5
# On a free tier, widen the batching window or the daily quota is gone by
# mid-morning - Gemini's free gemini-2.5-flash allows 20 requests a day.
# AGENTS_WINDOW_S=5400
# AGENTS_FALLBACK_MODELS=claude-sonnet-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=

# ── levels and anomaly tuning ───────────────────────────────────────────────
# STRUCTURES_SIGMA=4          # per-venue cutoff, in sigma
# STRUCTURES_QUANTILE=0.999   # joint-model cutoff
# STRUCTURES_WARMUP=60
# STRUCTURES_COOLDOWN_S=900
#
# The measured spread is charged against every level call before it is judged,
# so a push that does not clear its own cost stops qualifying. Set this to 0
# only to ask what the model would have said gross - it logs a warning while
# off, because a configured cost of zero and a broken one look identical in the
# journal otherwise. The charge is far from uniform: about 0.003v on btc
# against 2.5v on gbpusd intraday.
# STRUCTURES_CHARGE_SPREAD=1

# How swings are found, and therefore where levels are drawn. A comma list
# runs each pass and merges them, which is the point: they find different
# prices and the outcome machinery says which gets respected.
#   pip       bar extremes by prominence - the baseline, drawn everywhere
#   run       boundaries between runs of volatility
#   origin    turns whose impulse set a new running extremum - a break of
#             structure in desk language. Roughly one level per ten origins,
#             because origins are spread across prices while pip and run pile
#             up; and on a 500-bar window it draws none at all on gold at 1m,
#             5m or 15m, so it is worth adding rather than selecting alone.
#   profile   price bands holding the most activity - the market-data form of
#             a cost-basis shelf. Refuted as a *source* of levels (a node is
#             reached no more often than an arbitrary price the same distance
#             away) and kept as a **vote**: passes are merged, so it cannot
#             draw a level of its own that anything trades, only put a fourth
#             name on a price another pass already drew.
#   equal     two or more extremes at the SAME price, within a quarter unit.
#             `pip` ranks turns by prominence and says nothing about whether
#             two happened at one price - a double top is not two significant
#             highs, it is two highs at one price.
#   gap       an untraded range: three bars where the first bar's high sits
#             below the third's low. The only formation defined by trade that
#             did NOT happen. Filled gaps are not emitted.
#   round     numbers people can say out loud. The only one that reads no
#             history at all, which makes it either a free level or a
#             superstition - it is here to be measured, not assumed. The step
#             comes from the instrument's own volatility rather than a table.
#   both      an alias for pip,run
#
# The passes are merged, not pooled, and each level records which of them found
# it. That count is published as `drawn_by_n` on every level call, which is what
# makes "is a price all four agree on respected more" a question the journal can
# answer.
STRUCTURES_FORMATION=pip,run,origin,profile,equal,gap,round

# Monetary policy on signals, and as its own shape. Reads the FRED series the
# news service collects; silent if there are none. Off is for a deployment with
# no news service, which already degrades to silence anyway.
STRUCTURES_MACRO=1

# ── notifications (only read when NOTIFICATIONS_ENABLED=1) ─────────────────
# What reaches a channel. Everything is allowed unless narrowed - the level
# routing above is one axis and it is not enough on its own, because a stale
# feed and a level call can both be `warning` while being different things to
# a reader. A stale feed also re-fires every few seconds for as long as it
# stays stale; all of that belongs in the journal, little of it on a phone.
#
# NOTIFY_SHAPES=level,drift,agent,trade  # calls, regime changes, findings, fills
#
# `trade` is what the trading service publishes on a fill, a close and
# (if asked) a decline. Leaving it out of a narrowed NOTIFY_SHAPES is what
# keeps trades off a channel that is meant for findings - which is the
# default state, so adding it here is an opt-in.
# NOTIFY_FEEDS=gold,btc            # these instruments only
# NOTIFY_COOLDOWN_S=900            # the same finding at most once per 15m
# NOTIFY_MAX_PER_HOUR=20           # a ceiling whatever else got through

# TELEGRAM_BOT_TOKEN=
#
# A public channel can be addressed by its @username - no numeric id needed,
# and the bot must be an administrator of it with "post messages" allowed.
# TELEGRAM_CHAT_IDS=signals=@till_infinity_signals
#
# Several at once, each with its own minimum level, so an on-call chat and a
# firehose can share one bot:
# TELEGRAM_CHAT_IDS=signals=@till_infinity_signals, ops=-1001111|critical
# DISCORD_WEBHOOK_URLS=alerts=https://discord.com/api/webhooks/...

# ── logging ─────────────────────────────────────────────────────────────────
# TILL_LOG_LEVEL=INFO

# ── trading (only read when TRADING_ENABLED=1) ─────────────────────────────
# The only service that can lose money, so it is off unless asked for and on
# paper unless separately armed. Neither switch implies the other.
#
# TRADING_ENABLED=1          # start the service at all
# TRADING_LIVE=1             # and send orders to the account. Without this,
#                            # everything runs - sizing, stops, journal - and
#                            # fills are simulated against the live quote.
#
# Which terminal. Left alone it picks what the host can reach: the native
# MetaTrader5 package if it imports (Windows, or a Wine prefix with a Windows
# Python), the bridge if a URL is set, paper otherwise. `trading doctor` prints
# the table and says which was chosen and why.
# TRADING_BACKEND=auto       # auto | mt5 | mt5-rpyc | mt5-http | paper
#
# Auto prefers whichever is closest to the terminal: in-process, then the
# module proxied over RPyC, then the HTTP bridge, then paper.
#
# RPyC - a Windows Python inside the Wine prefix serving the MetaTrader5
# module, which this process gets a proxy of. Faster than the bridge and with
# the whole API rather than the wrapped subset. The `mt5linux` package packages
# it; `wine python -m rpyc.utils.server --port 18812 ThreadedServer` is the
# server. Needs `uv sync --extra rpyc`.
#
# NEVER point this at a server on a public interface: allow_all_attrs makes it
# a remote-code-execution service by design. Localhost, a private network, or
# an SSH tunnel.
# TRADING_RPYC_HOST=127.0.0.1
# TRADING_RPYC_PORT=18812
#
# The bridge - github.com/nodalytics/metatrader-terminal - MT5 under Wine behind
# FastAPI. This is the Linux path.
# TRADING_MT5_URL=http://localhost:8000
# TRADING_MT5_API_KEY=
# metatrader-terminal exposes an account endpoint and the client finds it.
# The older mt5-api does not, and then risk has nothing to size against unless
# this is set. Harmless either way; the client says when it falls back to it.
# TRADING_ACCOUNT_EQUITY=10000
#
# The native terminal. Blank credentials mean "whatever is already logged in",
# which is the normal case on a desktop.
# TRADING_MT5_LOGIN=
# TRADING_MT5_PASSWORD=
# TRADING_MT5_SERVER=
# TRADING_MT5_TERMINAL=      # path to terminal64.exe, if it is not the default
#
# What to scalp. Gold and BTC by default; the rest are opt-in and only trade
# if the broker actually quotes them - `trading symbols` asks it. A broker that
# carries XAUUSD and BTCUSD very often carries no SOLUSD under any name.
# TRADING_SYMBOLS=gold,btc
# TRADING_INTERVALS=1m,5m
#
# Which strategies run. Several may run together; the one-position-per-
# instrument limit is what stops two of them doubling a position.
# `trading strategies` lists them with what each one claims.
#
# THE ORDER IS A DECISION, not a set. The first taker wins, so a strategy that
# is another one plus extra refusals can only ever see what the permissive one
# declined - and it declined those for reasons the stricter one would decline
# too. Listed second it never trades, and nothing looks wrong: it loads, it
# reports as enabled, it books nothing forever. Start-up warns when it can see
# this, but the rule is simple: most selective first, permissive last.
# level-scalp is the baseline every other strategy is a restriction of, so it
# belongs at the END, where a catch-all does its job instead of starving the
# rest.
# TRADING_STRATEGIES=sweep-aware,fade-to-value,approach-scalp,level-scalp
#
# Scalps, swings, both or neither - a coarser switch that filters whatever the
# list above selected. 'none' runs the service and takes no trades, which is a
# state worth having and is announced loudly because it looks like a fault.
# Swings are swing-level, runner, approach-scalp and fade-to-value: the names
# lie, and the last two hold for four hours.
# TRADING_STYLE=both
#
# Extra terminals that copy every filled decision, as name=url[|api_key].
# Risk is replicated and lots are not - each account re-sizes against its own
# equity, because 0.05 lots on a 2,000-unit account is five times the risk it
# is on a 10,000-unit one.
# TRADING_FOLLOWERS=second=http://host:8000|key
#   level-scalp        the call as published - stop beyond the level, target the push
#   confluence-scalp   only levels another timeframe agrees on, wider stop
#   momentum-scalp     only calls agreeing with three speeds of recent edge
#   approach-scalp     buy up to the level above, sell down to the level below
#   sweep-aware        level-scalp, unless the stop sits in front of liquidity
#   fade-to-value      the distance from spot to the best-evidenced level
#   swing-level        a 4h/1d/1w level, triggered as low as 15m
#   snap               the same call, held for seconds rather than half an hour
#   thesis-only        the stop moved out to a circuit breaker; exits on target
#   runner             the target moved out past the push; the trail exits it
#   inverse            the same calls, traded the other way - a control
#   council            four agents, different reasoning modes, discuss once
#
# The council needs a model credential like `agents` does, and costs eight
# model calls per signal considered (four voices, two rounds). Any failure
# reads as an abstention.
# TRADING_COUNCIL_QUORUM=2           # voices that must agree
# TRADING_COUNCIL_MIN_CONVICTION=0.55
# TRADING_COUNCIL_DISCUSS=1          # 0 halves the calls, and the point
# TRADING_COUNCIL_TIMEOUT_S=25
# TRADING_COUNCIL_DAILY_CALLS=400    # a cost ceiling, not a quality setting
#
# Risk. The plan sets every limit consistently; any variable below that is
# actually set wins over it. `trading plans` prints what each commits to.
# TRADING_RISK_PLAN=standard      # conservative | standard | aggressive
# TRADING_RISK_FRACTION=0.0025    # of equity, per trade
# TRADING_DAILY_LOSS_FRACTION=0.03
# TRADING_MAX_POSITIONS=4
# TRADING_MAX_PER_SYMBOL=1
# Off. Re-verified 2026-08-27 over 47,676 production touches joined to the
# signals that produced them: 0.908R ungated against 0.868R at the 1.2 floor
# that was live, and monotonically worse as the floor rises. The quality
# difference is 0.047R; the volume difference is everything - it refused 40,421
# of 47,676 calls to gain nothing.
#
# The ratio is |net_push| / risk_vol, so a high value is substantially a small
# risk_vol - a tight stop. `Level.stop_for` states the principle it violates:
# "a stop inside it is a stop inside the noise - it gets hit by the level
# working." The structures-side gate was removed on 2026-08-17 for the same
# reason; this is the trading side catching up.
# TRADING_MIN_RR=0.0
# TRADING_MIN_PROBABILITY=0.58
# Must stay above reactions.MIN_EDGE (0.10) or it can never fire - every call
# on the bus has already cleared that. See docs/edge.md for where 0.15 is from.
# TRADING_MIN_EDGE=0.15
# TRADING_MAX_SPREAD_FRACTION=0.25
# TRADING_LOSS_COOLDOWN_S=900
# TRADING_MAX_HOLD_S=1800         # a strategy may ask for longer
#
# Standing aside. All three fail open: no calendar means no blackout, fewer
# than three venues reporting means no dislocation check, no drift signal means
# no pause. A collector restarting must not stop the system trading.
#
# Seconds, not minutes, and wider after the print than before it - before, the
# job is only to not be holding when the number lands; after, the spread is at
# its widest and the first move often reverses.
# TRADING_NEWS_BEFORE_S=600
# TRADING_NEWS_AFTER_S=900
# A US release blacks out gold, BTC and all seven majors, because the dollar is
# on one side of every one of them.
#
# Our broker against the six venues `prices` already collects.
# TRADING_MAX_DISLOCATION_BPS=8      # how far our quote may sit from the median
# TRADING_MAX_SPREAD_RATIO=2.5       # how much more than the group we may pay
# TRADING_DRIFT_PAUSE_S=900          # stand aside after a regime change
#
# Net exposure per currency, as a fraction of equity. max_positions counts
# tickets; this counts the trade they add up to - long EURUSD + GBPUSD + AUDUSD
# is one short-dollar position at three times the risk. Harmless on gold and
# BTC alone; load-bearing the day the majors are switched on. 0 disables.
# TRADING_MAX_CURRENCY_EXPOSURE=0.005
#
# The least a stop may sit from the level, in volatility units. Fair value is a
# distribution and volatility is its width, so a stop inside one unit is inside
# the estimate's own noise and is taken by ordinary movement rather than by the
# thesis failing. Applied from BOTH anchors - the level and the fill - because
# entry is a market order and can land most of the way to a level-anchored
# stop, and sizing measures from the fill.
# TRADING_MIN_STOP_VOL=1.0
#
# Do not close a trade that is working just because the clock ran out. The hold
# exists to release capital from a thesis that is not playing out; on age alone
# it was also cutting the ones that were - out at 4623 on a gold fall that
# carried to 4592. A trade this far in front (in R) is moved to break even
# first and then kept, so an extension can scratch but cannot turn a winner
# into a loser. 0 disables and restores the old behaviour.
# TRADING_HOLD_EXTENDS_AT=1.0
# TRADING_MAX_HOLD_MULTIPLE=4.0   # total age cap, as a multiple of the hold
#
# Moving a stop once the trade is on. Both OFF by default and deliberately so:
# each cuts the loss tail and each cuts winners, and nothing here has measured
# which dominates. Turn them on to run the experiment, not because they sound
# prudent. If you use these, switch the mt5-api trailing handler off - two
# things moving one stop on different clocks will race.
# TRADING_BREAK_EVEN_AT=1.0     # R multiple at which the stop goes to entry
# TRADING_BREAK_EVEN_TICKS=2    # ticks past entry, to cover the spread
# TRADING_TRAIL_VOL=1.0         # volatility units to trail behind the best price
# TRADING_TRAIL_SIGMAS=0.5      # share of the level's wick spread the trail clears
#
# Scaling out. The push distribution is wide - median 2.24v, p90 4.93v - so one
# exit has to pick which half of it to serve. Banking part at the modelled push
# and running the rest serves both. A position that cannot be split into two
# tradeable halves runs whole rather than being closed entirely.
# The broker's own minimum stop distance is not checked when the order is
# built - it is checked against the price when the order lands. A eurgbp buy
# was refused with a stop of 0.00022 against a 0.00020 minimum: the old
# hard-coded 10% margin was two points, which a quiet cross covers between
# deciding and sending. The spread is added on top, because a buy fills at the
# ask and its stop is measured against the bid.
# Momentum, as a filter rather than a strategy. `max_against_vol` lives on the
# strategies that asked for it and refuses an entry while a run is still going
# against it. This is the stricter half: after a pullback, the move must have
# turned back in the trade's favour before the entry is taken.
#
# Only applied after a pullback, and that is not a detail: momentum at a level
# is adverse by construction - price arriving at support is falling, which is
# what arriving means - so requiring favourable momentum on arrival would
# refuse every support buy. After the pullback the same reading means the fall
# has not finished.
# Trend context (structures/trend.py). Measured 2026-08-27 over 54,143
# resolutions and the strongest separation found here: levels in the most
# trending decile break 1.4% of the time and return 1.149R, against 11.3% and
# 0.807R in the chop. It holds inside every interval and strengthens as the
# timeframe slows (+0.081 on 1m, +0.245 on 15m).
#
# A trend does NOT run levels over - breaks are rarest where the trend is
# cleanest. It makes levels hold harder and pay more, so this is a
# pullback-in-trend effect and "trade the trend" would have the sign backwards.
#
# Two shapes, both here so they can be compared. The floor refuses chop; the
# sizing leans with the whole curve instead of a cliff edge, is bounded because
# 0.34R justifies leaning rather than doubling, and is applied to
# `risk_fraction` so every cap downstream still binds.
# Sizing for the stop we get rather than the stop we place. Measured across the
# stopped trades in the journal: realised loss is 1.09R against the 1.00R they
# were sized for, and the decomposition puts most of it on the way out - entry
# slippage +0.025R, exit slippage +0.062R. A broker stop is a market order once
# triggered, so it fills through the spread; that half is a property of stops.
#
# What this corrects is the risk budget, not the returns. Positions get ~8%
# smaller and losses land where they were meant to. Without it every stop
# breaches the budget by the same constant.
# A tighter stop, only for an entry that waited for its level.
#
# Scored over resolved touches, a 0.5v stop with a 1.5v target returns +1.785R
# against +0.630R for the 1.05v/2.53v pair production actually places. But
# `min_stop_vol` exists because a stop inside one volatility unit is taken by
# ordinary movement, with two live trades cited for it.
#
# Both are right, and they measure from different places: the replay measures
# from the LEVEL, and a market entry is not at the level. A 0.5v stop from the
# level is a real stop; the same from a fill already 0.3v past it is 0.2v of
# room. So the tighter stop is worth exactly what the entry is worth, and a
# parked entry is the only kind that is actually at the level.
#
# Needs TRADING_PULLBACK_FRACTION above zero to do anything at all. Only ever
# tightens - a larger value than the ordinary floor is capped, not applied.
# Do not pay the spread to leave on the clock.
#
# Found live: an aus200 position was quoted bid 8998 / ask 9051 out of ASX
# hours - 53 points against a normal 1 to 2, and against the trade's own 8.89
# of risk. A long marks at the bid, so it showed -61 on a 19 budget while its
# true mid had not reached the stop, and the hold clock was minutes from
# turning that arithmetic into a realised loss.
#
# TRADING_MAX_SPREAD_FRACTION already refuses to ENTER on a wide spread. That
# is the easy half - an entry can always wait. This is the other half.
#
# Measured against the trade's own risk rather than a baseline spread, which
# is self-calibrating and needs no history. Bounded by MAX_HOLD_MULTIPLE, so a
# permanently wide instrument cannot hold a position open forever.
# TRADING_HOLD_MAX_SPREAD=0.5
#
# Stop distance, in volatility units, for an entry that WAITED for its level.
# Zero keeps the ordinary stop; this only ever tightens, never widens.
#
# The replay's best cell is a 0.5v stop with a 1.5v target, +1.785R against the
# +0.630R of the pair production places - and TRADING_MIN_STOP_VOL exists
# because a stop inside one unit dies to ordinary movement. Both are right:
# the replay measures from the LEVEL, and a market entry is not at the level.
# A parked entry is, which is what waiting buys, so the number applies there
# and nowhere else.
#
# Measured on gold at 4400 (one unit $4.40), entry parked below its support:
#
#   fill past the level    off       at 0.5v
#   0.0v                   1.11v     0.61v risk, R:R 1.26 -> 2.28
#   0.3v / 0.6v            1.00v     0.50v risk, R:R 1.40 -> 2.80
#   1.0v                   1.00v     refused, "through"
#
# The refusal is the cost, not a bug: a long filling a full unit below its
# support has a fill past the price the stop is anchored to. With
# TRADING_ENTRY_EDGE_VOL at 1.5 and a median entry 0.91v from its level, a
# typical rest fills ~0.6v past and is safe; the quartile already close to its
# level fills past 1.0v and is declined rather than taken with a stop already
# behind price.
#
# Bounded to holds under 300s whatever this says, which keeps a short-hold
# grid's number off a swing.
TRADING_PARKED_STOP_VOL=0.5
#
# TRADING_STOP_SLIPPAGE=0.09
#
# TRADING_MIN_EFFICIENCY=0.3   # refuse below this. 0 is off
# TRADING_TREND_SIZING=0.3     # 0.7x in chop, 1.3x in a trend. 0 is off
#
# TRADING_REQUIRE_TURN_VOL=0.5  # volatility units the turn must have run. 0 is off
#
# The three direction gates were measured on 2026-08-27 and none of them
# separates outcomes. Probability and edge slope slightly the wrong way across
# spreads indistinguishable from noise. Base rate has the largest spread of the
# three (0.130) and is not monotonic: deciles 2-4, *below* an even chance,
# return ~0.99 - better than deciles 5-7 above them. A floor in the middle
# removes good trades and keeps worse ones, and 0.51 sat exactly there.
#
# A first pass bucketed the raw base rate rather than the direction-adjusted
# value the gate compares, found a standout top decile, and a floor set from it
# refused 99 signals out of 99. Raw 0.60 is a strong buy and a weak sell; the
# harness adjusts in `gates._facing` now.
#
# What replaces them is confirmation - momentum, with candles as fallback -
# which asks about timing rather than direction.
# TRADING_MIN_PROBABILITY=0.0
# TRADING_PROBABILITY_PERCENTILE=0.0
# TRADING_MIN_EDGE=0.0
# TRADING_MIN_BASE_RATE=0.0
#
# Candlestick confirmation at the level - hammer, shooting star, engulfing. The
# bar must touch the level and close on the trade's side. Costs the entries
# that never get confirmed.
# TRADING_REQUIRE_CANDLE=1
# TRADING_CANDLE_TOLERANCE_VOL=0.25
#
# TRADING_STOPS_LEVEL_MARGIN=1.25   # multiple of stops_level a stop must clear
#
# TRADING_SCALE_OUT_AT=1.0        # R multiple at which part comes off. 0 is off
# TRADING_SCALE_OUT_FRACTION=0.5  # how much. Must be strictly between 0 and 1
#
# Closing a trade that never started. The median touch resolves in eighteen
# seconds and 84% inside five minutes, against holds measured in half hours. A
# position still at its entry long past that is giving noise time to reach the
# stop, which is a losing trade arrived at slowly.
# TRADING_STALE_AFTER_S=300     # seconds before a trade that went nowhere is cut. 0 is off
# TRADING_STALE_MOVE=0.25       # R it must have reached to count as having started
#
# Re-taking a setup a sweep interrupted. Six of twelve stopped trades later
# reached their target, by 3.7R to 25.7R. What re-arms is the signal, back
# through every gate - not the intent, which the stop already contradicted.
# Needs TRADING_PULLBACK_FRACTION above zero: at a stop, price is at the worst
# point the trade has seen, so re-entering at market buys the extreme.
# TRADING_REENTRY_MAX=1         # times one stopped setup may be retaken. 0 is off
#
# Trading toward a level (approach-scalp).
# TRADING_APPROACH_MIN_VOL=0.8
# TRADING_APPROACH_MAX_VOL=6.0
# TRADING_APPROACH_BUFFER_VOL=0.25   # stop short of the level by this much
# TRADING_APPROACH_MIN_REACH=0.20    # a floor against the unreachable, not a forecast
#
# Announcements. Gated three ways because the three messages have very
# different volumes, and all of them still pass through the notification
# filter - if NOTIFY_SHAPES has been narrowed, `trade` has to be in it.
# TRADING_NOTIFY=1
# TRADING_NOTIFY_FILLS=1
# TRADING_NOTIFY_CLOSES=1
# TRADING_NOTIFY_DECLINES=0    # the most informative and the easiest to drown in
#
# The BASE of a magic band, not a single number. The base itself means
# "ours, strategy unknown"; each strategy stamps base+n so a position at the
# broker says which one opened it, and ownership is the band base..base+999.
# Positions outside it are never touched. Copying to a second ACCOUNT? Keep the
# same base. Running a second PROCESS against one account? It needs a different
# one, or the two will reconcile each other's trades.
# TRADING_MAGIC=777701
