# STATESPACE_WARM_BARS=60
# SURPRISE_FEEDS=
# TILL_LOG_FILE=
# TILL_LOG_JSON=
# TILL_STATUS_PATH=
#
# Where the execution client writes down the stop and target the **broker
# confirmed**, so a position that goes naked across a restart can still be
# repaired. Defaults beside the status file, on the image's volume.
#
# The sweep copies the cache's own stop order, and reconciliation rebuilds a
# position *without* the bracket legs that protected it - so on 2026-11-10 a
# live XAUUSD short reported "no stop at the broker and no stop order in the
# cache to copy" every sixty seconds and had to be given a stop by hand. The
# cache is still consulted first, because a trailing stop moves there.
# TILL_PROTECTION_PATH=
# TRADER_ID=TILL-001
# TRADING_AGE_BREAK_RISK=1
# TRADING_AGREEMENT_SHARE=0.0
# TRADING_BAND_EXIT_TURN=both
