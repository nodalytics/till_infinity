# TRADING_VENUES=
# TRADING_VOLATILE_ONLY=0
#
# Which rules the screen gates. Empty is **every** rule, which is rarely what
# is wanted: the screen is a scalping filter and `smc-bos-causal` holds 96 bars
# - `structure.HOLD_MINUTES // 15`, a full day - against `vol-impulse`'s 16.
# Gating the long rule restricts it to a universe its own measurements were
# never taken on.
#   TRADING_VOLATILE_RULES=vol-impulse,zones
# TRADING_VOLATILE_RULES=
#
# **The screen warms from history, and it has to.** `_rank` will not rank an
# instrument until it has 20 bars of that instrument's own, and
# `Desk._volatile_enough` refuses every signal until a ranking exists - so
# without a history request this flag is a **five-hour trading halt after
# every deploy** at a 15-minute base. Measured on 2026-11-10: the screen came
# up at 19:04 and at 19:19 reported "no instrument with 20 bars yet, of 38
# subscribed" while four signals were refused as `no-ranking`.
# TRADING_VOLATILITY_TARGET_BPS=0.0
# TRADING_ZONE_ATR=0
# TRADING_ZONE_DUTY=1.0
# TRADING_ZONE_LEFT=0
# TRADING_ZONE_MIN_TESTED=0
# TRADING_ZONE_MODE=reject
# TRADING_ZONE_MULT=0.0
# TRADING_ZONE_MULT_TILT=1.0
# TRADING_ZONE_ON_OPPOSITE=close
# TRADING_ZONE_PIVOTS=ha
# TRADING_ZONE_PRESET=script
# TRADING_ZONE_RIGHT=0
# TRADING_ZONE_STOP_TILT=1.0
# TRADING_ZONE_STOP_VOL=3.0
