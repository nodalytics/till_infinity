# TRADING_PAPER_SPREAD_BPS=2.0
# TRADING_PARALLEL=0
# TRADING_PULLBACK_BARS=10.0
# TRADING_PULLBACK_FRACTION=0.0
# TRADING_PULLBACK_MAX_VOL=4.0
# TRADING_PULLBACK_MIN_GAIN=0.25
# TRADING_PULLBACK_MIN_SWEEP_RATE=0.1
# TRADING_PULLBACK_MIN_WICKS=2.0
# TRADING_PULLBACK_SIGMAS=0.5
# TRADING_QUIET_HOURS=
# TRADING_REGIME_BAND=0.0
# TRADING_REGIME_FLOOR=0.5
# TRADING_RETRIES=3
# TRADING_SESSION_BARS=1400
# TRADING_SESSION_MARGIN_S=60.0
# TRADING_SHADOW_WINDOW=1.0
# TRADING_STALE_QUOTE_AFTER_S=300.0
# TRADING_STOP_HOLD_SCALING=0.0
# TRADING_SWEEP_MAX_EXPOSURE=0.8
# TRADING_SWEEP_MAX_RATE=0.35
# TRADING_SWEEP_MIN_HISTORY=6.0
