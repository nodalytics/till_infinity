//@version=5
// FOCuS Origin Zones - detect on the anchor, place on the refinement
//
// Two timeframes and no more:
//
//   * The **anchor** decides *that* a change happened, and how much it matters.
//     Slow, so there are few of them and each one is an event.
//   * The **refinement** decides *where* the zone goes, inside the anchor bar
//     that carried the change. Fast, so the band is tight enough to rest an
//     order in.
//
// Running a detector on four timeframes and drawing all of them - which is what
// the first version of this did - produces a chart of noise: the fast
// timeframes fire constantly and their zones bury the ones that matter. The
// split below is the fix, and it is not a compromise. It is what the research
// measured.
//
// **Detection and placement are different questions and the same statistic is
// not best at both.** Scored as origin locators over 6,300 paired comparisons
// on 8 instruments, by how far each estimate moves when the sampling grid is
// shifted by a minute:
//
//     the extreme inside the bar     0.107v   <- placement
//     FOCuS                          0.161v   <- detection
//     MD-FOCuS (OHLC as a vector)    0.194v
//     NEWMA                          0.211v
//     the bar's close (do nothing)   0.226v
//     BOCPD                          0.237v   worse than doing nothing
//     KCP                            0.237v   worse than doing nothing
//     RuLSIF                         0.251v   worse than doing nothing
//
// So FOCuS picks the *bar* and the extreme inside it picks the *price*. Using
// FOCuS for both is worse, and every blend of the two is worse than the extreme
// alone - 0.107v against 0.153v at a quarter weight, degrading as more is
// mixed in. An origin **is** an extremum, so weight on any other price moves
// off the thing being estimated.
//
// A CUSUM would report where the run got long enough to be sure. FOCuS
// maximises the same likelihood ratio over every possible start at once and
// reports the argmax - where the move began - which is the level.

indicator("FOCuS Origin Zones", overlay = true, max_boxes_count = 500,
     max_labels_count = 500)

// ---------------------------------------------------------------- inputs

anchorTf = input.timeframe("240", "Anchor - detects the change",
     tooltip = "The timeframe the change point is found on. Slow: this is what " +
     "makes a zone rare enough to be worth drawing. 4h by default.")
refineTf = input.timeframe("5", "Refinement - places the zone",
     tooltip = "The resolution the origin is located at inside the anchor bar. " +
     "5m by default: fine enough that the band is an order's width rather " +
     "than a region of the chart. Must be no finer than the chart itself, " +
     "since the chart's bars are what it is built from - on a 15m chart a 5m " +
     "refinement quietly becomes 15m, and the zone is wider than it says.")

thresholdNats = input.float(12.0, "Threshold (nats of evidence)", minval = 1.0, step = 1.0,
     tooltip = "A log likelihood ratio: how much evidence before this is worth " +
     "saying. 12 is what the source repository ships - on a stationary " +
     "Gaussian stream it produced at most 5 false alarms across five runs of " +
     "3,000 bars. Raise it for fewer, stronger zones.")
scaleLength = input.int(100, "Volatility lookback (anchor bars)", minval = 20,
     tooltip = "Steps are divided by a running average step size, so the " +
     "threshold means the same thing on gold and on a JPY cross.")

minAgree = input.int(3, "Minimum timeframes agreeing", minval = 1, maxval = 4,
     tooltip = "The measured filter, and the reason this is not just a " +
     "prettier support/resistance tool. A change point calling on three or " +
     "more timeframes is followed by +7.92v a day out; one calling on a " +
     "single timeframe by -1.24v - opposite signs, not the same event at two " +
     "strengths. 3 is that cut. Set it to 1 to draw every anchor change and " +
     "see what the filter is removing.")
agreeWindow = input.int(6, "Agreement window (anchor bars)", minval = 1, maxval = 24,
     tooltip = "How long a call from one timeframe stands while the others " +
     "are given a chance to agree. Measured in anchor bars so that one window " +
     "covers every timeframe: giving each its own bar length hands the 5m " +
     "detector five minutes and the 4h one four hours, and agreement becomes " +
     "an artefact of the fastest clock rather than a fact about the market.")

maxZones  = input.int(12, "Zones kept per side", minval = 1, maxval = 100,
     tooltip = "Old zones are removed as new ones arrive. Twelve a side is " +
     "about as many as a chart can carry and still be read.")
minGapAtr = input.float(1.0, "Minimum gap between zones (ATR)", minval = 0.0, step = 0.25,
     tooltip = "A new zone within this distance of the last one on the same " +
     "side is skipped. Two zones a few ticks apart are one level drawn twice.")
extendRight = input.bool(true, "Extend zones to the right")
showLabels  = input.bool(true, "Label each zone")
fadeUsed    = input.bool(true, "Fade a zone once price trades back through it",
     tooltip = "The claim a zone makes is unfilled interest. Each return " +
     "trades some of it away, so a zone price has already worked through is " +
     "not the same object as a fresh one.")

supportCol    = input.color(color.new(color.teal, 75),   "Support",    inline = "c")
resistanceCol = input.color(color.new(color.maroon, 75), "Resistance", inline = "c")

// ------------------------------------------------------------- the detector
//
// FOCuS, written out. The candidates that can ever be the maximum lie on the
// lower convex hull of the cumulative sums, so a candidate inside the hull can
// never beat both its neighbours whatever arrives next and is dropped once
// rather than re-tested for ever. What is claimed is exactness - the statistic
// equals the brute-force maximum over every start - not a complexity bound.
//
// Returns the *time* the change started, so the chart can find the anchor bar
// it belongs to. A bar offset would be in anchor bars and meaningless here.

focusScan(bool wantUp, float nats, int lookback) =>
    var float running = 0.0
    var int   seen    = 0
    var array<float> hullSum  = array.new_float()
    var array<int>   hullSeen = array.new_int()
    int startedAt = na

    step  = ta.change(close)
    scale = ta.ema(math.abs(step), lookback)

    if not na(step) and not na(scale) and scale > 0 and bar_index > lookback
        if array.size(hullSum) == 0
            array.push(hullSeen, seen)
            array.push(hullSum, running)

        running += step / scale
        seen    += 1

        float best  = 0.0
        int   where = 0
        for i = 0 to array.size(hullSum) - 1
            tau = array.get(hullSeen, i)
            gap = seen - tau
            if gap > 0
                raw  = running - array.get(hullSum, i)
                diff = wantUp ? raw : -raw
                if diff > 0
                    score = diff * diff / (2.0 * gap)
                    if score > best
                        best  := score
                        where := tau

        bool pruning = true
        while pruning and array.size(hullSum) >= 2
            n     = array.size(hullSum)
            leftS = array.get(hullSum,  n - 2)
            leftT = array.get(hullSeen, n - 2)
            midS  = array.get(hullSum,  n - 1)
            midT  = array.get(hullSeen, n - 1)
            slope = (running - leftS) / math.max(1, seen - leftT)
            onIt  = leftS + slope * (midT - leftT)
            if wantUp ? (midS >= onIt) : (midS <= onIt)
                array.pop(hullSum)
                array.pop(hullSeen)
            else
                pruning := false
        array.push(hullSeen, seen)
        array.push(hullSum, running)

        if best >= nats
            back = math.max(0, math.min(seen - where, bar_index))
            startedAt := time[back]
            // Reset, so what comes out is a discrete call rather than a level
            // sitting above a line for ever.
            running := 0.0
            seen    := 0
            array.clear(hullSum)
            array.clear(hullSeen)
    startedAt

// `lookahead_off` is load-bearing. Without it an anchor bar is visible before
// it has closed, every historical zone is drawn using its own future, and the
// indicator looks superb on history and does nothing live.
upStart = request.security(syminfo.tickerid, anchorTf, focusScan(true,  thresholdNats, scaleLength),
     lookahead = barmerge.lookahead_off)
dnStart = request.security(syminfo.tickerid, anchorTf, focusScan(false, thresholdNats, scaleLength),
     lookahead = barmerge.lookahead_off)

anchorSecs = timeframe.in_seconds(anchorTf)
refineSecs = math.max(timeframe.in_seconds(refineTf), timeframe.in_seconds(timeframe.period))
atr = ta.atr(14)

// ------------------------------------------------------- the agreement ladder
//
// The two timeframes the user sets are the ends. The rungs between them are
// derived rather than asked for, because the measurement is about *how many*
// timeframes agree and not about which ones - and three more inputs to express
// that would be three more things to get wrong.
//
// Geometric spacing, snapped to timeframes a chart actually aggregates to. With
// the defaults - 5m to 4h - the ladder is 5m, 15m, 1h, 4h, which is exactly the
// set `research/agreeing.md` measured.

snap(float seconds) =>
    ladder = array.from(60, 180, 300, 900, 1800, 3600, 7200, 14400, 28800, 86400)
    best = 60
    float gap = na
    for i = 0 to array.size(ladder) - 1
        v = array.get(ladder, i)
        d = math.abs(math.log(v) - math.log(math.max(seconds, 1)))
        if na(gap) or d < gap
            gap := d
            best := v
    str.tostring(best / 60)

ratio  = math.pow(math.max(anchorSecs, 1) / math.max(refineSecs, 1), 1.0 / 3.0)
rung1  = snap(refineSecs)
rung2  = snap(refineSecs * ratio)
rung3  = snap(refineSecs * ratio * ratio)
rung4  = snap(anchorSecs)

// Whether each rung has called a change recently, in each direction. Only the
// count is used - which rung fired is not the reading.
recent(string tf, bool wantUp) =>
    t = request.security(syminfo.tickerid, tf, focusScan(wantUp, thresholdNats, scaleLength),
         lookahead = barmerge.lookahead_off)
    var int held = na
    if not na(t)
        held := t
    not na(held) and (time - held) <= agreeWindow * anchorSecs * 1000

// The count, and **how high the confirmation reaches**.
//
// The anchor rung agrees by construction - a zone only exists because the
// anchor fired - so the informative quantity is which of the rungs *below* it
// also called, and the highest of those is worth more than the lowest. A 4h
// change confirmed down to 5m is a different object from one confirmed only at
// 15m, even where both have three rungs agreeing.
//
// **The count is measured and the height is a prior.** `agreeing.md` scored the
// count - 3+ continues, 1 alone reverses - and did not score which rungs. The
// height is here because a slower timeframe firing is a larger event by
// construction, which the same document measured as a confound rather than as
// an effect. It shades the drawing and gates nothing.

u1 = recent(rung1, true),  u2 = recent(rung2, true)
u3 = recent(rung3, true),  u4 = recent(rung4, true)
d1 = recent(rung1, false), d2 = recent(rung2, false)
d3 = recent(rung3, false), d4 = recent(rung4, false)

agreeingUp = (u1 ? 1 : 0) + (u2 ? 1 : 0) + (u3 ? 1 : 0) + (u4 ? 1 : 0)
agreeingDn = (d1 ? 1 : 0) + (d2 ? 1 : 0) + (d3 ? 1 : 0) + (d4 ? 1 : 0)
// The highest rung *below the anchor* that confirms it, 0 for none.
reachUp = u3 ? 3 : u2 ? 2 : u1 ? 1 : 0
reachDn = d3 ? 3 : d2 ? 2 : d1 ? 1 : 0
rungName(int r) => r == 3 ? rung3 : r == 2 ? rung2 : r == 1 ? rung1 : "none"

// ------------------------------------------------------- the refinement
//
// Estimator F, and the one that won. The rule is the origin's own definition
// applied one resolution down: the origin is the last price before the impulse
// took over, so inside the anchor bar it is the **highest** close for a drop
// and the **lowest** for a rally.
//
// Chart bars are grouped into refinement-sized buckets by their timestamp, so
// the answer does not depend on the chart being set to exactly `refineTf` -
// only on it being no coarser.

refineZone(int startTime, bool wantUp) =>
    float bestClose = na
    float zoneHigh  = na
    float zoneLow   = na
    int   bucketAt  = na
    if not na(startTime)
        stop = startTime + anchorSecs * 1000
        // Walk back over chart bars covering the anchor bar. Bounded, because
        // an unbounded lookback on a fast chart is a script that times out.
        for i = 0 to math.min(bar_index, 5000)
            t = time[i]
            if na(t) or t < startTime
                break
            if t < stop
                bucket = t - t % (refineSecs * 1000)
                c = close[i]
                better = na(bestClose) or (wantUp ? c < bestClose : c > bestClose)
                if better
                    bestClose := c
                    bucketAt  := bucket
        if not na(bucketAt)
            // The bucket's own range is the band - what actually traded there,
            // rather than a padded constant nobody has measured.
            for i = 0 to math.min(bar_index, 5000)
                t = time[i]
                if na(t) or t < bucketAt
                    break
                if t < bucketAt + refineSecs * 1000
                    zoneHigh := na(zoneHigh) ? high[i] : math.max(zoneHigh, high[i])
                    zoneLow  := na(zoneLow)  ? low[i]  : math.min(zoneLow,  low[i])
    [zoneHigh, zoneLow, bucketAt]

// ------------------------------------------------------------------ drawing

var array<box>   upBoxes = array.new_box()
var array<box>   dnBoxes = array.new_box()
var array<label> upTags  = array.new_label()
var array<label> dnTags  = array.new_label()
var float lastUpPrice = na
var float lastDnPrice = na

place(int startTime, bool wantUp, int agreed, int reach) =>
    [zHigh, zLow, at] = refineZone(startTime, wantUp)
    if not na(zHigh) and not na(zLow) and not na(at) and agreed >= minAgree
        anchorPrice = wantUp ? zLow : zHigh
        last = wantUp ? lastUpPrice : lastDnPrice
        // Two zones a few ticks apart are one level drawn twice.
        far = na(last) or na(atr) or math.abs(anchorPrice - last) >= minGapAtr * atr
        if far
            if wantUp
                lastUpPrice := anchorPrice
            else
                lastDnPrice := anchorPrice
            // Opacity carries the agreement count. A zone at the minimum is
            // drawn faint and one every timeframe confirms is drawn solid,
            // because that difference is the measured part.
            plain = wantUp ? supportCol : resistanceCol
            base  = color.new(plain, math.max(25, 88 - agreed * 10 - reach * 5))
            boxes = wantUp ? upBoxes : dnBoxes
            tags  = wantUp ? upTags  : dnTags
            b = box.new(left = at, top = zHigh, right = time, bottom = zLow,
                 xloc = xloc.bar_time, bgcolor = base, border_color = base,
                 extend = extendRight ? extend.right : extend.none)
            array.push(boxes, b)
            if showLabels
                array.push(tags, label.new(x = at, y = wantUp ? zLow : zHigh,
                     xloc = xloc.bar_time,
                     text = (wantUp ? "▲ " : "▼ ") + str.tostring(agreed) + " tf, to " +
                          rungName(reach) + "m",
                     style = wantUp ? label.style_label_up : label.style_label_down,
                     color = base, textcolor = chart.fg_color, size = size.tiny))
            // Bounded, because a set that only grows is a leak with a long fuse.
            while array.size(boxes) > maxZones
                box.delete(array.shift(boxes))
            while array.size(tags) > maxZones
                label.delete(array.shift(tags))

if not na(upStart)
    place(upStart, true, agreeingUp, reachUp)
if not na(dnStart)
    place(dnStart, false, agreeingDn, reachDn)

// A zone's claim is unfilled interest, and each return trades some of it away.
// Faded rather than deleted: a level price has worked through is still a level,
// it is just weaker evidence - which is the same thing `revisits` records in
// the source repository.
if fadeUsed and barstate.isconfirmed
    for i = 0 to array.size(upBoxes) - 1
        b = array.get(upBoxes, i)
        if low <= box.get_top(b) and low >= box.get_bottom(b)
            box.set_bgcolor(b, color.new(supportCol, 93))
            box.set_border_color(b, color.new(supportCol, 93))
    for i = 0 to array.size(dnBoxes) - 1
        b = array.get(dnBoxes, i)
        if high >= box.get_bottom(b) and high <= box.get_top(b)
            box.set_bgcolor(b, color.new(resistanceCol, 93))
            box.set_border_color(b, color.new(resistanceCol, 93))

alertcondition(not na(upStart) and agreeingUp >= minAgree, "FOCuS support zone",
     "A rally's origin was located and confirmed across timeframes")
alertcondition(not na(dnStart) and agreeingDn >= minAgree, "FOCuS resistance zone",
     "A drop's origin was located and confirmed across timeframes")

plotchar(agreeingUp, "timeframes agreeing up",   "", location.top,    display = display.status_line)
plotchar(agreeingDn, "timeframes agreeing down", "", location.bottom, display = display.status_line)
plotchar(reachUp,    "confirmation reaches up",   "", location.top,    display = display.status_line)
plotchar(reachDn,    "confirmation reaches down", "", location.bottom, display = display.status_line)
