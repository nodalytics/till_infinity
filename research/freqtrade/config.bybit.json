{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "_comment": "Research backtesting only on Bybit linear perps: no keys, never live. api.bybit.com is blocked from the desk's network; bytick.com is Bybit's own alternate domain. See README.md.",
  "dry_run": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDT",
  "stake_amount": 100,
  "dry_run_wallet": 10000,
  "max_open_trades": 12,
  "timeframe": "15m",
  "fee": 0.00055,
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT",
      "XRP/USDT:USDT",
      "DOGE/USDT:USDT",
      "ADA/USDT:USDT",
      "AVAX/USDT:USDT",
      "LINK/USDT:USDT",
      "LTC/USDT:USDT",
      "DOT/USDT:USDT",
      "TRX/USDT:USDT"
    ],
    "pair_blacklist": [],
    "ccxt_config": {
      "hostname": "bytick.com"
    },
    "ccxt_async_config": {
      "hostname": "bytick.com"
    }
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "datadir": "user_data/data/bybit",
  "user_data_dir": "user_data",
  "dataformat_ohlcv": "feather"
}